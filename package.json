{
  "name": "novatek-material-flow",
  "private": true,
  "version": "0.1.0",
  "description": "NOVATEK — Material Flow Interactive Factory Experience. Presentación académica inmersiva 3D sobre manejo de materiales (Ingeniería de Métodos 2, UNSA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pdf": "npm run build && node tools/export_pdf.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.1",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "5.1.2"
  }
}
